<Window x:Class="B3DMTest.Viewer3D"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="B3DM Viewer" Height="800" Width="1200"
        Loaded="Window_Loaded" Closing="Window_Closing" Closed="Window_Closed">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="24"/>
        </Grid.RowDefinitions>

        <!-- 툴바 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Background="#FF2D2D30" VerticalAlignment="Center" Margin="4,0">
            <TextBlock Text="URL:" Foreground="White" VerticalAlignment="Center" Margin="4,0"/>
            <TextBox x:Name="txtUrl" Width="500" Margin="4,0" Padding="4,2" VerticalAlignment="Center"
                     Text="https://211.178.39.228:22480//terra_b3dms_HyeopjaeBeach/tileset.json"
                     KeyDown="txtUrl_KeyDown"/>
            <Button x:Name="btnLoad" Content="OK" Margin="4,0" Padding="12,4"
                    Click="btnLoad_Click"/>
        </StackPanel>

        <!-- 3D 뷰어 영역 -->
        <Border Grid.Row="1" Background="#0F1A33" BorderThickness="1" BorderBrush="#444"
                KeyDown="Border_KeyDown" KeyUp="Border_KeyUp"
                MouseWheel="clientView_MouseWheel">
            <Grid x:Name="clientViewGrid"/>
        </Border>

        <!-- 상태바 -->
        <StatusBar Grid.Row="2" Background="#FF1E1E1E">
            <StatusBarItem>
                <TextBlock x:Name="txtStatus" Text="준비" Foreground="White" FontSize="11"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock x:Name="txtCameraPos" Text="Camera: (0, 0, 0)" Foreground="LightGray" FontSize="11"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
